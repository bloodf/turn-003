{
  "name": "realmwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/shelf.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "node e2e/run.cjs && node e2e/table.cjs",
    "campaigns": "LONGTEST=1 vitest run tests/modules.test.ts -t \"whole campaigns\"",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/grenze": "^5.3.0",
    "@noble/secp256k1": "^3.2.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.5.438",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "ws": "^8.23.0"
  }
